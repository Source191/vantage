<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The fast suite: domain rules, reducers, use cases and read models over in-memory fakes. No temp folders, no git,
    no processes. Infrastructure is referenced so sociable tests can assemble the real adapters over a fake process
    runner; Tui so the architecture test can inspect its assembly and DialogEffectsShould can ask which effects have a dialog.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Source191.Vantage.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Source191.Vantage.Core\Source191.Vantage.Core.csproj" />
    <ProjectReference Include="..\..\src\Source191.Vantage.Infrastructure\Source191.Vantage.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Source191.Vantage.Tui\Source191.Vantage.Tui.csproj" />
    <ProjectReference Include="..\Source191.Vantage.TestDoubles\Source191.Vantage.TestDoubles.csproj" />
  </ItemGroup>

</Project>

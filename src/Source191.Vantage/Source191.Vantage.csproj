<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Source191.Vantage</RootNamespace>
    <AssemblyName>vantage</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vantage</ToolCommandName>
    <PackageId>Source191.Vantage</PackageId>
    <Version>0.2.0</Version>
    <Authors>Simon Vane</Authors>
    <Description>A terminal console for Claude Code sessions and git worktrees on Windows.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Source191.Vantage.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

</Project>

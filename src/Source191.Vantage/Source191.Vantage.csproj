<Project Sdk="Microsoft.NET.Sdk">

  <!-- The vantage tool: Program.cs wires Core, Infrastructure and Tui together. Packing includes the three referenced projects. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Source191.Vantage</RootNamespace>
    <AssemblyName>vantage</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vantage</ToolCommandName>
    <PackageId>Source191.Vantage</PackageId>
    <Version>0.17.0-preview.2</Version>
    <!-- The version option prints exactly the package version; the commit stays in the package's repository metadata. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Simon Vane</Authors>
    <Description>A terminal console for Claude Code sessions and git worktrees on Windows.</Description>
    <Copyright>Copyright 2026 Simon Vane</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Source191/vantage</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Source191/vantage</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>claude-code;worktrees;windows-terminal;tui;dotnet-tool</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Vantage is English only, so the translated resources of System.CommandLine and Terminal.Gui are neither built nor packed. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- release.yml generates each version's notes on its GitHub Release; nuget.org links there rather than to a changelog file. -->
    <PackageReleaseNotes>Release notes: https://github.com/Source191/vantage/releases/tag/v$(Version)</PackageReleaseNotes>
  </PropertyGroup>

  <!-- The README is the package readme and the notices travel beside the tool, as the licences of the packed dependencies ask. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon\vantage.ico" Link="vantage.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source191.Vantage.Core\Source191.Vantage.Core.csproj" />
    <ProjectReference Include="..\Source191.Vantage.Infrastructure\Source191.Vantage.Infrastructure.csproj" />
    <ProjectReference Include="..\Source191.Vantage.Tui\Source191.Vantage.Tui.csproj" />
  </ItemGroup>

</Project>
